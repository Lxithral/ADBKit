<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小部件：每个设置一格。SwitchesWidget 通过把格子的 fill/icon/label 设为 enabled，
     由 color/ 与 drawable/ 里的 selector 产生开/关配色。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="5dp">

    <FrameLayout
        android:id="@+id/cell_developer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/fill_developer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/icon_developer"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/tile_ic_developer_options"
                android:tint="@color/widget_content" />

            <TextView
                android:id="@+id/label_developer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_short_developer"
                android:textColor="@color/widget_content"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cell_usb"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/fill_usb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/icon_usb"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/tile_ic_usb_debugging"
                android:tint="@color/widget_content" />

            <TextView
                android:id="@+id/label_usb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_short_usb"
                android:textColor="@color/widget_content"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/cell_wireless"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/fill_wireless"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_cell" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/icon_wireless"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/tile_ic_wireless_debugging"
                android:tint="@color/widget_content" />

            <TextView
                android:id="@+id/label_wireless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_short_wireless"
                android:textColor="@color/widget_content"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
